{
  "name": "urai",
  "version": "0.1.0",
  "private": true,
  "description": "Spectrogram and FFT explainer with a hand-written Cooley-Tukey transform.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "node scripts/preview.mjs",
    "test": "vitest",
    "test:run": "vitest run",
    "test:dsp": "vitest run tests/oracle tests/analytic tests/properties tests/windows",
    "bench:fft": "vitest run --config vitest.bench.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "next lint"
  },
  "dependencies": {
    "next": "14.2.15",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.19",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.15",
    "postcss": "8.4.39",
    "tailwindcss": "3.4.6",
    "typescript": "5.5.3",
    "vitest": "1.6.0"
  },
  "packageManager": "pnpm@9.15.9"
}
